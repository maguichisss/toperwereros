{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "permission": {
    "bash": {
      "*": "ask",
      "cat*": "allow",
      "sed*": "allow",
      "tail*": "allow",
      "head*": "allow",
      "sort*": "allow",
      "wc*": "allow",
      "ls*": "allow",
      "diff*": "allow",
      "find*": "allow",
      "echo*": "allow",
      "cd*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "*scripts/deploy*": "ask",
      "docker push*": "ask",
      "docker stack deploy*": "ask",
      "docker compose *docker-compose.pi.yml*": "ask",
      "docker compose *docker-compose.prod.yml*": "ask",
      "*COMPOSE_FILE=docker-compose.pi.yml docker compose*": "ask",
      "*COMPOSE_FILE=docker-compose.prod.yml docker compose*": "ask",
      "gcloud run deploy*": "ask",
      "gcloud builds submit*": "ask",
      "gcloud * deploy*": "ask",
      "*.env*": "ask",
      "*secrets/*": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask"
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "*scripts/deploy*": "ask",
          "docker push*": "ask",
          "docker stack deploy*": "ask",
          "docker compose *docker-compose.pi.yml*": "ask",
          "docker compose *docker-compose.prod.yml*": "ask",
          "*COMPOSE_FILE=docker-compose.pi.yml docker compose*": "ask",
          "*COMPOSE_FILE=docker-compose.prod.yml docker compose*": "ask",
          "gcloud run deploy*": "ask",
          "gcloud builds submit*": "ask",
          "gcloud * deploy*": "ask",
          "*.env*": "ask",
          "*secrets/*": "ask"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}
