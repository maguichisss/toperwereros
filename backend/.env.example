# =============================================================
#  Store Catalog — backend environment template (.env.example)
# =============================================================
#  Copy to backend/.env (dev) or backend/.env.pi / .env.prod and fill in
#  real values. Never commit real .env* files. scripts/init-env.sh copies
#  this file and generates a fresh random JWT_SECRET.
#  The Compose section mirrors the per-host root .env schema (docker-compose*.
#  yml interpolation source) for reference/documentation.

# ---------- Auth ----------
JWT_SECRET=dev-secret-change-in-production           # 64+ chars recommended for prod
JWT_EXPIRE_MINUTES=1440                              # token lifetime in minutes (24h default)

# ---------- Logging ----------
LOG_LEVEL=INFO                                       # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------- CORS ----------
CORS_ORIGINS=*                                       # comma-separated allowed origins; * for dev

# ---------- Admin (seed) ----------
DEFAULT_ADMIN_PASSWORD=admin123                      # seeded admin password


# ---------- Database ----------
DB_NAME=store_catalog
DB_USER=postgres
DB_PASS=postgres                                     # URL-encode special chars (@ : / %)
DB_HOST=db                                           # 'db' inside the compose network
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ---------- GCP ----------
GCP_PROJECT=                                         # required only for GCS/Cloud SQL
GCP_REGION=
CLOUD_SQL_INSTANCE=store-catalog                     # Cloud SQL instance (prod proxy)
# ---------- Cloud SQL ----------
CLOUD_SQL_CONNECTION_STRING=${GCP_PROJECT}:${GCP_REGION}:${CLOUD_SQL_INSTANCE}   # PROJECT:REGION:INSTANCE (cloud only)

# ---------- Uploads ----------
GCS_BUCKET=                                          # empty = local disk storage

# ---------- Images & ports ----------
POSTGRES_IMAGE=postgres:16-alpine                    # db image (dev/pi)
POSTGRES_PORT=5432                                   # host port exposing the db (dev)
BACKEND_PORT=3001                                    # host port exposing the API (dev)
FRONTEND_PORT=5173                                   # host port exposing Vite (dev)
HTTP_PORT=80                                         # host port for the nginx terminator (pi)
HTTPS_PORT=443                                       # host TLS port for the nginx terminator (pi)

# ---------- DB healthcheck ----------
PG_HEALTH_INTERVAL=5s
PG_HEALTH_TIMEOUT=5s
PG_HEALTH_RETRIES=10

# ---------- Restart policy ----------
RESTART_POLICY=unless-stopped

# ---------- Frontend (dev) ----------
VITE_PROXY_TARGET=http://backend:3001                # backend address Vite proxies to
VITE_HTTPS_CERT=/app/certs/192.168.1.41+3.pem        # dev-machine TLS cert
VITE_HTTPS_KEY=/app/certs/192.168.1.41+3-key.pem     # dev-machine TLS key

# ---------- Frontend (prod) ----------
BACKEND_URL=http://backend:8080                      # API base URL the deployed frontend calls

# ---------- Cloud SQL proxy ----------
CLOUDSQL_PROXY_IMAGE=gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.1
CLOUDSQL_PROXY_PORT=5432                             # proxy listen + locally published port